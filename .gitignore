# Build output (large, regenerated on every build)
src-tauri/target/
target/

# Node dependencies (restored with `npm install`)
node_modules/

# Files generated by the Tauri build tool
src-tauri/gen/

# Python
__pycache__/
*.pyc
.venv/
venv/

# Operating system files
.DS_Store
Thumbs.db
desktop.ini

# Editor settings
.vscode/
.idea/
*.swp

# Secrets: never commit API keys or local env files
.env
.env.*
*.key
*.pem

# Logs and temporary files
*.log
*.tmp
